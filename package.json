{
  "name": "word-ga",
  "version": "0.1.0",
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-moonbit": "^0.5.1",
    "vitest": "^5.0.5"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "(cd moonbit && moon build --target wasm-gc --release) && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --config oxlint.json src/",
    "fmt": "oxfmt src/",
    "fmt:check": "oxfmt --check src/",
    "test:mutation": "node node_modules/@stryker-mutator/core/bin/stryker.js run",
    "test:mutation:moonbit": "bun scripts/moonbit-mutation.mjs"
  },
  "type": "module",
  "dependencies": {
    "chart.js": "^4.6.1",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "qs": "^6.16.1"
  }
}
